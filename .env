# Assignment-11: Environment Configuration 
# File: .env
# ----------------------------------------------------------

# ----------------------------------------------------------
# Application Settings
# ----------------------------------------------------------
ENV=development
DEBUG=True
LOG_LEVEL=INFO
APP_NAME=FastAPI_Modular_Calculation_Model

# ----------------------------------------------------------
# LOCAL DEVELOPMENT + PYTEST DATABASE (SQLite)
# ----------------------------------------------------------
# Used ONLY in:
#   • pytest local runs
#   • local development WITHOUT Docker
#   • your test suite (test_cal_model, test_database, schemas)
#
# Do NOT remove this.
TEST_DATABASE_URL=sqlite:///./test.db

# ----------------------------------------------------------
# DOCKER + PRODUCTION DATABASE (PostgreSQL)
# ----------------------------------------------------------
# Used ONLY when running docker-compose or GitHub CI
POSTGRES_USER=ps_user
POSTGRES_PASSWORD=ps_password
POSTGRES_DB=calc_m11_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# PostgreSQL SQLAlchemy URL (used ONLY in Docker)
DATABASE_URL=postgresql://ps_user:ps_password@db:5432/calc_m11_db

# ----------------------------------------------------------
# JWT Authentication Settings
# ----------------------------------------------------------
SECRET_KEY=super_secret_key_987654321
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ----------------------------------------------------------
# pgAdmin Configuration
# ----------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@local.com
PGADMIN_DEFAULT_PASSWORD=admin123
